# Copy to /opt/tdx/.env on the server (see DEPLOY.md)

# Exchange (optional)
# API_KEY=
# SECRET=

# Dashboard login — required on public hosts
# DASHBOARD_AUTH_USERNAME=admin
# DASHBOARD_AUTH_PASSWORD=choose-a-long-random-password
# DASHBOARD_SECRET_KEY=at-least-16-random-characters
# DASHBOARD_COOKIE_SECURE=1
